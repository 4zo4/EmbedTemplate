{
  "default_paths": {
    "clone_tools_dir": "~/tools",
    "clone_os_dir": "~/kernel",
    "clone_bsp_dir": "~/bsp"
  },
  "base_requirements": {
    "packages": [
      "git",
      "wget",
      "build-essential",
      "cmake",
      "ccache",
      "numactl",
      "perl",
      "libfl-dev",
      "zlib1g-dev",
      "libgoogle-perftools-dev",
      "libglib2.0-dev",
      "libpixman-1-dev",
      "libslirp-dev",
      "ninja-build",
      "libjson-c-dev",
      "libcmocka-dev",
      "gcc-multilib",
      "libc6-dev-i386",
      "python3-venv",
      "python3-pip",
      "socat",
      "xterm",
      "x11-xserver-utils",
      "xfonts-base",
      "xfonts-utils"
    ],
    "repos": [
      { "slug": "qemu/qemu", "id": "qemu", "type": "tools", "tag": "v11.1.0", "clone_depth": 1 },
      { "slug": "4zo4/FreeRTOS-Kernel", "id": "freertos", "dir": "freertos", "type": "os",
        "branch": "feature/embed_template_updates" },
      { "slug": "TF-A/trusted-firmware-a", "id": "tfa", "dir": "tf-a", "type": "bsp", "tag": "v2.15.0",
        "branch": "master", "upstream_url": "https://git.trustedfirmware.org/TF-A/trusted-firmware-a.git",
        "sparse": ["lib/libc", "include/lib/libc", "include/export"] }
    ]
  },
  "scopes": [
    {
      "id": "arm_toolchain",
      "name": "ARM Toolchain",
      "description": "Compiler toolsets and C library support targets for ARM architectures",
      "packages": ["gcc-arm-none-eabi", "binutils-arm-none-eabi", "libnewlib-arm-none-eabi"],
      "repos": []
    },
    {
      "id": "riscv_toolchain",
      "name": "RISC-V Toolchain",
      "description": "Compiler toolsets and C library support targets for RISC-V",
      "packages": ["gcc-riscv64-unknown-elf", "picolibc-riscv64-unknown-elf"],
      "repos": []
    },
    {
      "id": "networking",
      "name": "PCIe Co-Simulation Networking",
      "description": "Packet inspection tools, socket utilities, and virtualization interface dependencies",
      "packages": ["tshark", "lsof", "wireshark", "python3-bpfcc", "bpfcc-tools"],
      "repos": []
    },
    {
      "id": "debug",
      "name": "Debug Tools",
      "description": "Cross-architecture debugging utilities",
      "packages": ["gdb-multiarch"],
      "repos": []
    },
    {
      "id": "peakrdl",
      "name": "PeakRDL",
      "description": "RDL (Register Description Language) processing tool",
      "packages": [],
      "repos": [
        { "id": "peakrdl", "slug": "4zo4/PeakRDL-cheader", "dir": "peakrdl", "type": "tools", "branch": "feature/custom-templates" }
      ]
    }
  ]
}
